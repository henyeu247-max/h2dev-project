# Mẫu .env — copy thành .env rồi điền key thật.
# .env thật bị web block (403); file mẫu này cũng bị block (regex /^\.env($|\.)/i).
TRENDS_KEYS=tmcp_live_key1,tmcp_live_key2
VIDIQ_KEY=vidiq_xxx
EXA_KEY=xxx
JINA_KEY=jina_xxx
# Pipelines hoat-hinh-ai / ton-giao
KIE_API_KEY=
ELEVENLABS_API_KEY=
IMGBB_API_KEY=
# Groq Whisper (transcribe_sku / speech_density / voice_stt_language); fallback: D:/Linly-Dubbing/config/groq_config.json
GROQ_API_KEY=
