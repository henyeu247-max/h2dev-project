# Mẫu .env — copy thành .env rồi điền key thật.
# .env thật bị web block (403); file mẫu này cũng bị block (regex /^\.env($|\.)/i).
TRENDS_KEYS=tmcp_live_key1,tmcp_live_key2
VIDIQ_KEY=vidiq_xxx
EXA_KEY=xxx
JINA_KEY=jina_xxx
# Gemini Vision/Audio (Engine A CLIProxyAPI -> Engine B Direct AI Studio fallback)
CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXY_API_KEY=
GEMINI_API_KEY=
GEMINI_KEYS=
# Pipelines hoat-hinh-ai / ton-giao
KIE_API_KEY=
ELEVENLABS_API_KEY=
IMGBB_API_KEY=
# Groq Whisper (transcribe_sku / speech_density / voice_stt_language)
GROQ_API_KEY=
# VPS SSH Sync (auto_ingest_pipeline.js / sync_videos_to_vps.py)
H2DEV_VPS_HOST=
H2DEV_VPS_PORT=26266
H2DEV_VPS_USER=root
H2DEV_VPS_SSH_KEY=~/.ssh/<SSH_KEY_NAME>
H2DEV_VPS_APP_DIR=/opt/h2dev/app
