{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "H2DEV": "readonly",
    "H2Core": "readonly",
    "tailwind": "readonly"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }],
    "no-undef": "error",
    "no-implicit-globals": "off",
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-console": "off",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-prototype-builtins": "warn",
    "no-redeclare": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-unsafe-negation": "error",
    "no-fallthrough": "error",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-self-assign": "error",
    "no-unreachable": "error",
    "no-useless-escape": "warn"
  },
  "overrides": [
    {
      "files": ["assets/icons/**", "**/*.min.js"],
      "rules": {}
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "_archive/",
    "assets/icons/",
    "assets/tailwind.css",
    "data/",
    "data-tabs/",
    "docs/",
    "*.min.js"
  ]
}
