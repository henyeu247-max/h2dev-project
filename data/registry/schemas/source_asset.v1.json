{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2dev://schema/source_asset.v1.json",
  "title": "H2DEV source_asset contract v1",
  "description": "Strict A1 contract. Runtime semantics are enforced by schema-validate.js; this is not a full JSON-Schema implementation.",
  "contract_profile": {
    "name": "h2dev-contract-v1",
    "version": "1",
    "runtime": "scripts/registry/schema-validate.js",
    "supported_keywords": [
      "type",
      "required",
      "properties",
      "additionalProperties",
      "items",
      "enum",
      "const",
      "pattern",
      "format",
      "minLength",
      "minItems",
      "minimum",
      "oneOf",
      "uniqueItems"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entity_id",
    "entity_type",
    "revision",
    "status",
    "created_at",
    "supersedes",
    "source_refs",
    "sensitivity",
    "retention_class",
    "provenance",
    "status_axes",
    "retention_policy",
    "kind",
    "source_locator",
    "provider",
    "mime",
    "content_hash",
    "acquired_at",
    "rights_evidence"
  ],
  "properties": {
    "schema": {
      "const": "h2dev.source_asset.v1"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^SRC\\-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "entity_type": {
      "const": "source_asset"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "pending",
        "active",
        "observed",
        "unverified",
        "needs_review",
        "verified",
        "corroborated",
        "approved",
        "rejected",
        "stale",
        "expired",
        "blocked",
        "ready",
        "in_progress",
        "complete",
        "failed",
        "cancelled",
        "tombstoned",
        "needs_adapter",
        "published",
        "private_candidate",
        "archived",
        "superseded",
        "unknown"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Za-z0-9][A-Za-z0-9._-]*)+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity_id",
            "revision"
          ],
          "properties": {
            "entity_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Za-z0-9][A-Za-z0-9._-]*)+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:SRC|OBS|LSKU|CH|OWN-CH|CV|NICHE|CLM|EVD|DEC|EP|ART|RUN|MET|REL|POL)-[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "credential",
        "personal_data"
      ]
    },
    "retention_class": {
      "enum": [
        "owned_asset",
        "derived_internal",
        "provider_refresh_required",
        "provider_ephemeral_signed_url",
        "credential_or_token",
        "legal_hold"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "agent",
        "method",
        "input_hashes",
        "generated_by"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "direct",
            "api",
            "mcp",
            "human",
            "derived",
            "import",
            "manual"
          ]
        },
        "input_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "generated_by": {
          "enum": [
            "human",
            "tool",
            "model",
            "none"
          ]
        },
        "derivation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:SRC|OBS|LSKU|CH|OWN-CH|CV|NICHE|CLM|EVD|DEC|EP|ART|RUN|MET|REL|POL)-[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "status_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_ok",
        "analysis_coverage",
        "accuracy",
        "rights",
        "human_review",
        "publish_ready"
      ],
      "properties": {
        "file_ok": {
          "enum": [
            "unknown",
            "not_applicable",
            "pending",
            "pass",
            "fail"
          ]
        },
        "analysis_coverage": {
          "enum": [
            "unknown",
            "not_applicable",
            "pending",
            "partial",
            "complete"
          ]
        },
        "accuracy": {
          "enum": [
            "unknown",
            "not_applicable",
            "unverified",
            "needs_review",
            "corroborated",
            "verified",
            "rejected"
          ]
        },
        "rights": {
          "enum": [
            "unknown",
            "not_applicable",
            "pending",
            "owned",
            "licensed",
            "public_reference",
            "cleared",
            "prohibited"
          ]
        },
        "human_review": {
          "enum": [
            "not_started",
            "not_applicable",
            "pending",
            "partial",
            "complete",
            "approved",
            "rejected"
          ]
        },
        "publish_ready": {
          "enum": [
            "unknown",
            "not_applicable",
            "blocked",
            "pending",
            "candidate",
            "approved"
          ]
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_class",
        "purge_authority",
        "policy_ref"
      ],
      "properties": {
        "retention_class": {
          "enum": [
            "owned_asset",
            "derived_internal",
            "provider_refresh_required",
            "provider_ephemeral_signed_url",
            "credential_or_token",
            "legal_hold"
          ]
        },
        "retention_due": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_due": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "purge_authority": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^POL-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "at",
          "by"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "purged_at",
        "policy_ref"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "purged_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^POL-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "payload_purged": {
          "const": true
        }
      }
    },
    "kind": {
      "enum": [
        "file",
        "url",
        "api_response",
        "media",
        "video",
        "document",
        "transcript",
        "platform_snapshot",
        "inline"
      ]
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "file_path",
            "url",
            "platform_id",
            "api_endpoint",
            "inline"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "path_base": {
          "enum": [
            "project",
            "absolute",
            "external_store",
            "provider"
          ]
        }
      }
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "mime": {
      "type": "string",
      "minLength": 1
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "rights_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_refs",
        "checked_at",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "owned",
            "licensed",
            "public_reference",
            "unknown",
            "prohibited",
            "cleared"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "checked_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "territory": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derivative_allowed": {
          "type": "boolean"
        },
        "attribution_required": {
          "type": "boolean"
        }
      }
    },
    "measurement_system": {
      "type": "string",
      "minLength": 1
    },
    "media_duration_seconds": {
      "type": "number",
      "minimum": 0
    }
  }
}
