{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2dev://schemas/gemini-video-analysis.v1",
  "title": "H2DEV Gemini video analysis",
  "type": "object",
  "required": ["schema_version", "sku", "source", "analysis"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "h2dev.gemini.video-analysis.v1"},
    "sku": {"type": "string", "pattern": "^VIDEO-[A-Za-z0-9]+$"},
    "source": {
      "type": "object",
      "required": ["path", "duration_sec", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "duration_sec": {"type": "number", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "analysis": {
      "type": "object",
      "required": ["interface", "model", "processing", "coverage", "observations", "claims", "limitations"],
      "additionalProperties": false,
      "properties": {
        "interface": {"enum": ["AI Studio web", "Gemini API", "unknown"]},
        "model": {"type": "string", "minLength": 1},
        "processing": {"enum": ["static", "agentic", "segmented", "unknown"]},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_sec", "end_sec", "status"],
            "additionalProperties": false,
            "properties": {
              "start_sec": {"type": "number", "minimum": 0},
              "end_sec": {"type": "number", "exclusiveMinimum": 0},
              "status": {"enum": ["complete", "partial", "failed", "not_processed"]},
              "note": {"type": "string"}
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_sec", "end_sec", "spoken", "visual", "on_screen_text", "confidence"],
            "additionalProperties": false,
            "properties": {
              "start_sec": {"type": "number", "minimum": 0},
              "end_sec": {"type": "number", "exclusiveMinimum": 0},
              "spoken": {"type": "string"},
              "visual": {"type": "string"},
              "on_screen_text": {"type": "string"},
              "confidence": {"enum": ["high", "medium", "low", "unclear"]},
              "note": {"type": "string"}
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_timestamps", "verification_status", "verification_sources"],
            "additionalProperties": false,
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "evidence_timestamps": {"type": "array", "items": {"type": "number", "minimum": 0}},
              "verification_status": {"enum": ["pending", "verified", "rejected", "unverified"]},
              "verification_sources": {"type": "array", "items": {"type": "string"}},
              "note": {"type": "string"}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "approved_for_ui": {"type": "boolean"}
  }
}
